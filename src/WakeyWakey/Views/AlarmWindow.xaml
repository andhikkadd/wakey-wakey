<Window x:Class="WakeyWakey.Views.AlarmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="WakeyWakey - Alarm Triggered"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Topmost="True"
        Background="#050409"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing"
        Deactivated="Window_Deactivated"
        StateChanged="Window_StateChanged">
    
    <Window.Resources>
        <!-- Custom styled glassmorphic input for answer entry -->
        <Style x:Key="GlassTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0Affffff"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#22ffffff"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CaretBrush" Value="#A78BFA"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Name="Border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#8B5CF6"/>
                                <Setter Property="Background" Value="#15ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom styled action button for submission -->
        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Background" Value="#8B5CF6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Border" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#7C3AED"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#6D28D9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimalist Test Mode Exit button -->
        <Style x:Key="TestExitButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#EF4444"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#EF4444"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Slow-pulsing ambient glow background -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#06050A" Offset="0"/>
                <GradientStop Color="#0C0A15" Offset="0.5"/>
                <GradientStop Color="#180C26" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Background Ambient Lighting Effect (Pulsing Ellipse) -->
        <Ellipse Width="800" Height="800" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.15" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#8B5CF6" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="0.8"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.1" To="0.25" Duration="0:0:5" AutoReverse="True"/>
                            <DoubleAnimation Storyboard.TargetProperty="Width" From="700" To="900" Duration="0:0:6" AutoReverse="True"/>
                            <DoubleAnimation Storyboard.TargetProperty="Height" From="700" To="900" Duration="0:0:6" AutoReverse="True"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Ellipse.Triggers>
        </Ellipse>

        <!-- Test Mode Panel (Top Right) -->
        <StackPanel Name="TestModePanel" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="40" Visibility="Collapsed">
            <TextBlock Text="[ TESTING MODE ACTIVE ]" Foreground="#EC4899" FontSize="12" FontWeight="Black" VerticalAlignment="Center" Margin="0,0,15,0"/>
            <Button Content="Exit Test Mode" Style="{StaticResource TestExitButton}" Click="ExitTest_Click" Height="30"/>
        </StackPanel>

        <!-- MAIN LAYOUT WRAPPER -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Alarm active label + Clock -->
                <RowDefinition Height="Auto"/> <!-- Glass challenge card -->
                <RowDefinition Height="Auto"/> <!-- Subtitle footer -->
            </Grid.RowDefinitions>

            <!-- Large Elegant Clock area -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,30">
                <!-- Glowing alarm badge -->
                <Border BorderBrush="#F43F5E" BorderThickness="1" CornerRadius="15" HorizontalAlignment="Center" Padding="12,5" Margin="0,0,0,15">
                    <Border.Background>
                        <SolidColorBrush Color="#22F43F5E"/>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="#F43F5E" Margin="0,0,8,0">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="1.0" Duration="0:0:0.5" AutoReverse="True"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <TextBlock Text="ALARM ACTIVE" Foreground="#F43F5E" FontWeight="Black" FontSize="11"/>
                    </StackPanel>
                </Border>
                
                <!-- Huge, modern thin typography for clock -->
                <TextBlock Name="ClockText" Text="07:00" Foreground="White" FontSize="120" FontWeight="ExtraLight" HorizontalAlignment="Center"/>
                <!-- Alarm Label -->
                <TextBlock Name="LabelText" Text="Wake Up!" Foreground="#94A3B8" FontSize="18" FontWeight="Light" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Translucent glassmorphic challenge panel -->
            <Border Grid.Row="1" Width="520" Background="#0Cffffff" BorderBrush="#15ffffff" BorderThickness="1" CornerRadius="24" Padding="35" SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="50" Opacity="0.5" ShadowDepth="5"/>
                </Border.Effect>
                
                <StackPanel>
                    <TextBlock Text="Solve the puzzle to disable the alarm" Foreground="#94A3B8" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,20" FontWeight="SemiBold"/>

                    <!-- Streak circular indicators -->
                    <StackPanel Name="StreakPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,25">
                        <!-- Instantiated dynamically in code-behind (e.g. rounded slate bubbles) -->
                    </StackPanel>

                    <!-- The math question (Oversized, crisp styling) -->
                    <TextBlock Name="QuestionText" Text="Loading..." Foreground="White" FontSize="46" FontWeight="ExtraBold" HorizontalAlignment="Center" Margin="0,0,0,25" TextAlignment="Center"/>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBox Name="AnswerTextBox" Grid.Column="0" Style="{StaticResource GlassTextBox}" Margin="0,0,10,0" 
                                 KeyDown="AnswerTextBox_KeyDown" HorizontalContentAlignment="Center" VerticalAlignment="Center"/>
                        
                        <Button Name="SubmitButton" Grid.Column="1" Content="Submit" Style="{StaticResource GlassButton}" 
                                Width="120" Height="62" Click="Submit_Click" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- User feedback message -->
                    <TextBlock Name="FeedbackText" Text="" Foreground="#F43F5E" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Safety notice -->
            <TextBlock Grid.Row="2" Text="WakeyWakey Personal Productivity Suite" Foreground="#475569" FontSize="10" HorizontalAlignment="Center" Margin="0,25,0,0"/>
        </Grid>
    </Grid>
</Window>
